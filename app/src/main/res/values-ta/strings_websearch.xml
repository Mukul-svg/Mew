<resources>
    <string name="settings_web_search">இணைய தேடல்</string>
    <string name="settings_web_search_sub">உண்மைகள், செய்திகள் மற்றும் விலைகள், இணையத்தில் சரிபார்க்கப்பட்டது</string>
    <string name="web_search_before">பதில் சொல்வதற்கு முன்</string>
    <string name="web_search_questions">கேள்விகள்</string>
    <string name="web_search_questions_sub">பொது உண்மைகள், செய்திகள் மற்றும் விலைகளைத் தேடுங்கள். தனிப்பட்ட தரவு மற்றும் செயல்களைத் தவிர்க்கவும்.</string>
    <string name="web_search_always">எப்போதும்</string>
    <string name="web_search_always_sub">செயல்கள் மற்றும் சிறு பேச்சு தவிர ஒவ்வொரு பதிலுக்கும் முன் தேடவும்.</string>
    <string name="web_search_off_sub">தானாக தேட வேண்டாம். தேவைப்படும்போது முகவர் இணையத்தில் தேடலாம்.</string>
    <string name="web_search_providers">வழங்குபவர்கள்</string>
    <string name="web_search_preferred">விருப்பமான வழங்குநர்</string>
    <string name="web_search_auto">ஆட்டோ</string>
    <string name="web_search_parallel">இணையாக தேடுங்கள்</string>
    <string name="web_search_parallel_sub">இரண்டு விசைகளும் அமைக்கப்பட்டிருக்கும் போது ஒரு தேடலுக்கு இரண்டு வழங்குநர்களைப் பயன்படுத்தவும். அதிக செலவு கூடும்.</string>
    <string name="web_search_test">சோதனை தேடல்</string>
    <string name="web_search_testing">சோதனை…</string>
    <string name="web_search_test_sub">சேமித்த விசைகளைக் கொண்டு ஒரு உண்மையான தேடலை இயக்கவும்.</string>
    <string name="web_search_privacy">தேர்ந்தெடுக்கப்பட்ட தேடல் வழங்குநர்களுக்கு வினவல்கள் செல்கின்றன. Mew எந்த தேடல் வரலாற்றையும் வைத்திருக்கவில்லை.</string>
    <string name="web_search_key_label">%1$s API விசை</string>
    <string name="web_search_add_key">விசையைச் சேர்க்கவும்</string>
    <string name="web_search_remove_key">விசையை அகற்று</string>
    <string name="web_search_no_keys">இன்னும் சாவிகள் இல்லை</string>
    <string name="web_search_test_failed">சோதனை தோல்வி: %1$s</string>
